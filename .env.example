# --- MCP server (your machine) ---
SHARE_HOST_URL=https://shareme.lol
SHARE_API_TOKEN=same-long-random-token-as-the-host
# Colon-separated (semicolon on Windows) absolute dirs agents may share from
SHARE_ALLOWED_DIRS=/Users/you/agent-output
SHARE_DEFAULT_TTL_HOURS=24
SHARE_MAX_FILE_MB=100
# Most extend_link will pass on for one x402 payment, in atomic units (1000000 = $1 USDC)
SHARE_MAX_PAYMENT_ATOMIC=1000000
